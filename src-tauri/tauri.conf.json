{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextGenUp",
  "version": "1.2.0",
  "identifier": "com.riponcm.nextgenup",
  "build": {
    "frontendDist": "../desktop-ui"
  },
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NextGenUp",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "matily.org",
    "copyright": "© 2026 matily.org · MIT License",
    "shortDescription": "AI image & video upscaling",
    "longDescription": "NextGenUp — open source AI image & video upscaling. A matily.org product.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nextgenup-server"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi",
        "installMode": "currentUser"
      }
    }
  }
}
